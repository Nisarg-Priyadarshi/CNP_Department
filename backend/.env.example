# Environment Variables Example
# Copy this file to .env and fill in your real values.
# DO NOT commit .env — it contains secrets.

MONGODB_URI=
PORT=5000

# JWT Authentication (Task 2J)
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_strong_random_secret_here_at_least_32_chars
JWT_EXPIRES_IN=7d

# Optional: roles a visitor may pick on the public register screen.
# Default (unset) = all five, preserving the current UI. In a real deployment
# restrict self-registration, e.g. REGISTRATION_ROLES=student
# REGISTRATION_ROLES=student,faculty_coordinator,faculty_mentor,club_admin,project_admin

# Cloudinary — File Storage (Task 2K)
# Get these from https://console.cloudinary.com → Settings → API Keys
# NEVER put real credentials here — this file is safe to commit.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
